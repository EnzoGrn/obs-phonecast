{
  "name": "obs-phonecast",
  "version": "0.1.0",
  "description": "Stream an Android app or screen into OBS via scrcpy's virtual display: no notifications, no nav bar, no webcam trick. One-click OBS dock included.",
  "type": "module",
  "license": "MIT",
  "author": "EnzoGrn",
  "homepage": "https://github.com/EnzoGrn/obs-phonecast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnzoGrn/obs-phonecast.git"
  },
  "bugs": {
    "url": "https://github.com/EnzoGrn/obs-phonecast/issues"
  },
  "keywords": [
    "obs",
    "obs-studio",
    "obs-websocket",
    "obs-dock",
    "android",
    "scrcpy",
    "screen-capture",
    "screen-mirroring",
    "phone-screen",
    "mobile-streaming",
    "mobile-gaming",
    "virtual-display",
    "streamer",
    "twitch",
    "youtube",
    "no-notifications",
    "adb",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/index.js",
    "build": "bun build --compile ./src/index.js --outfile dist/obs-phonecast",
    "build:win": "bun build --compile --target=bun-windows-x64 ./src/index.js --outfile dist/obs-phonecast.exe"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.6",
    "execa": "^9.5.2",
    "ws": "^8.21.3"
  },
  "bin": {
    "obs-phonecast": "src/index.js"
  },
  "files": [
    "src",
    "web",
    "launchers",
    "vendor",
    "README.md",
    "LICENSE"
  ]
}